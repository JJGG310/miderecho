# Clave de la API de Anthropic (https://console.anthropic.com). Sin ella, el asistente funciona en modo simulado.
ANTHROPIC_API_KEY=
# Modelo (opcional)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Gemini (Google): se usa solo si NO hay ANTHROPIC_API_KEY. Detalles en docs/ia.md
GEMINI_API_KEY=
# Obligatoria para usar Gemini: pago (facturación activa) o gratis (solo pruebas: cada respuesta lleva un aviso)
GEMINI_PLAN=
# aistudio (clave de aistudio.google.com) o vertex (clave de Vertex AI en modo express)
GEMINI_ENDPOINT=aistudio
GEMINI_MODEL=gemini-3.8-flash
PORT=8787
# Orígenes permitidos para la app (separados por coma). En desarrollo, Vite hace de proxy y no hace falta.
CORS_ORIGINS=http://localhost:5173
